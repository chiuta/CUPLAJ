<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleDisplayName</key><string>CUPLAJ</string>
  <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.10.0</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>LSRequiresIPhoneOS</key><true/>
  <key>UILaunchScreen</key><dict/>
  <key>UISupportedInterfaceOrientations</key>
  <array><string>UIInterfaceOrientationPortrait</string></array>
  <key>UIBackgroundModes</key><array><string>audio</string></array>
  <key>NSLocalNetworkUsageDescription</key><string>CUPLAJ connects to the show hub on the local Wi-Fi network.</string>
  <key>NSBonjourServices</key><array><string>_cuplaj._tcp</string></array>
  <key>NSMicrophoneUsageDescription</key><string>The microphone is used for phone calls during the show and for the audience meter (no audio is stored).</string>
  <key>NSCameraUsageDescription</key><string>The camera is only used to switch the torch on for light cues.</string>
  <key>NSMotionUsageDescription</key><string>Motion is measured only as a single number for the audience meter.</string>
  <key>CFBundleURLTypes</key>
  <array><dict>
    <key>CFBundleURLName</key><string>ro.trom.cuplaj</string>
    <key>CFBundleURLSchemes</key><array><string>cuplaj</string></array>
  </dict></array>
</dict>
</plist>
